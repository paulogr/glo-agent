{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glo",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "secrets": {
    "required": [
      "SLACK_CLIENT_ID",
      "SLACK_CLIENT_SECRET",
      "SLACK_SIGNING_SECRET",
    ],
  },
  "vars": {
    "GLO_AI_GATEWAY_ID": "default",
    "GLO_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glo",
      "database_id": "0a128cc1-fc2e-42dd-a518-b95bb364ee48",
      "migrations_dir": "./scripts/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GloOperationsSlackAgent",
        "name": "GloOperationsSlackAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GloOperationsSlackAgent"],
    },
  ],
}
